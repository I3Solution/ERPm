{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ekp:projection-manifest:1.0",
  "title": "Enterprise Knowledge Platform ProjectionManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "manifestId", "projectionRunId", "scope", "sourceId",
    "sourceRevisionId", "sourcePublication", "projectionKind", "profile",
    "builder", "definitionFingerprint", "projectionVersion", "state",
    "counts", "outputArtifacts", "contentHash", "publishedAtUtc"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "ekp.projection-manifest" },
        "version": { "const": "1.0" }
      }
    },
    "manifestId": { "type": "string", "minLength": 1 },
    "projectionRunId": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "workspaceId"],
      "properties": {
        "tenantId": { "type": "string", "minLength": 1 },
        "workspaceId": { "type": "string", "minLength": 1 },
        "projectId": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "sourceId": { "type": "string", "minLength": 1 },
    "sourceRevisionId": { "type": "string", "minLength": 1 },
    "sourcePublication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestId", "contentHash"],
      "properties": {
        "manifestId": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "minLength": 1 }
      }
    },
    "projectionKind": { "enum": ["full_text", "vector"] },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "version"],
      "properties": {
        "profileId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "definitionFingerprint": { "type": "string", "minLength": 1 },
    "projectionVersion": { "type": "string", "minLength": 1 },
    "state": { "const": "ready" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRecords", "eligibleItems", "indexedItems", "skippedItems", "failedItems"],
      "properties": {
        "sourceRecords": { "type": "integer", "minimum": 0 },
        "eligibleItems": { "type": "integer", "minimum": 0 },
        "indexedItems": { "type": "integer", "minimum": 0 },
        "skippedItems": { "type": "integer", "minimum": 0 },
        "failedItems": { "type": "integer", "minimum": 0 }
      }
    },
    "outputArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "storageRef", "contentHash", "byteLength", "itemCount"],
        "properties": {
          "artifactId": { "type": "string", "minLength": 1 },
          "storageRef": { "type": "string", "minLength": 1 },
          "contentHash": { "type": "string", "minLength": 1 },
          "byteLength": { "type": "integer", "minimum": 0 },
          "itemCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "contentHash": { "type": "string", "minLength": 1 },
    "publishedAtUtc": { "type": "string", "format": "date-time" }
  }
}
