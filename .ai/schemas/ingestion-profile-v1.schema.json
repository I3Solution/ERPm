{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ekp:ingestion-profile:1.0",
  "title": "Enterprise Knowledge Platform IngestionProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "profileId",
    "version",
    "connector",
    "extractor",
    "normalizer",
    "capture",
    "completeness",
    "triggers",
    "retry",
    "timeouts",
    "sourceAclRef",
    "retentionPolicyRef",
    "publication"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "ekp.ingestion-profile"
        },
        "version": {
          "const": "1.0"
        }
      }
    },
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "versionRange",
        "configRef"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "versionRange": {
          "type": "string",
          "minLength": 1
        },
        "configRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "versionRange",
        "outputContract"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "versionRange": {
          "type": "string",
          "minLength": 1
        },
        "outputContract": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "processors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "versionRange",
          "required"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "versionRange": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "normalizer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "versionRange",
        "canonicalContractVersion"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "versionRange": {
          "type": "string",
          "minLength": 1
        },
        "canonicalContractVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revisionStrategy",
        "consistentSnapshotRequired"
      ],
      "properties": {
        "revisionStrategy": {
          "enum": [
            "immutable_upstream_version",
            "content_hash_snapshot",
            "git_commit",
            "database_export"
          ]
        },
        "consistentSnapshotRequired": {
          "const": true
        }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredMetrics",
        "allowOptionalWarnings"
      ],
      "properties": {
        "requiredMetrics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "minimumCoverageRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimumRequiredItems": {
          "type": "integer",
          "minimum": 0
        },
        "allowOptionalWarnings": {
          "type": "boolean"
        }
      }
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "manual",
          "webhook"
        ]
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxAttempts",
        "initialBackoffSeconds",
        "maxBackoffSeconds",
        "retryableCategories"
      ],
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "initialBackoffSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "maxBackoffSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "retryableCategories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runTimeoutSeconds",
        "stageTimeoutSeconds"
      ],
      "properties": {
        "runTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "stageTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sourceAclRef": {
      "type": "string",
      "minLength": 1
    },
    "retentionPolicyRef": {
      "type": "string",
      "minLength": 1
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atomicityUnit",
        "preserveLastGoodRevision",
        "searchProjectionsAsync"
      ],
      "properties": {
        "atomicityUnit": {
          "const": "source_revision"
        },
        "preserveLastGoodRevision": {
          "const": true
        },
        "searchProjectionsAsync": {
          "const": true
        }
      }
    }
  }
}
