{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ekp:evidence:1.0",
  "title": "Enterprise Knowledge Platform Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidenceId",
    "scope",
    "sourceId",
    "sourceRevisionId",
    "locator",
    "capture"
  ],
  "properties": {
    "evidenceId": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "workspaceId"
      ],
      "properties": {
        "tenantId": {
          "type": "string",
          "minLength": 1
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "projectId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "sourceRevisionId": {
      "type": "string",
      "minLength": 1
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "sectionId": {
          "type": "string"
        },
        "objectPath": {
          "type": "string"
        },
        "externalId": {
          "type": "string"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "details": {
          "type": "object"
        }
      }
    },
    "contentHash": {
      "type": "string",
      "minLength": 1
    },
    "excerptRef": {
      "type": "string",
      "minLength": 1
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "producerVersion"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "producerVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
