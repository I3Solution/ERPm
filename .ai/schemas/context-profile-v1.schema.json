{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.enterprise-knowledge-platform.invalid/context-profile/1.0",
  "title": "Enterprise Knowledge Platform Context Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "profileId",
    "version",
    "allowedItemKinds",
    "selection",
    "budget",
    "lifecycle",
    "redactionPolicyRef"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "ekp.context-profile"
        },
        "version": {
          "const": "1.0"
        }
      }
    },
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "allowedItemKinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "structured_fact",
          "source_excerpt",
          "code_excerpt",
          "verified_relation",
          "generated_summary",
          "notice"
        ]
      }
    },
    "allowedDomains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowedPayloadTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyVersion",
        "deduplicate",
        "maxItems",
        "maxExcerptCharacters",
        "allowGeneratedSummaries"
      ],
      "properties": {
        "policyVersion": {
          "type": "string",
          "minLength": 1
        },
        "deduplicate": {
          "type": "boolean"
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1
        },
        "maxExcerptCharacters": {
          "type": "integer",
          "minimum": 1
        },
        "allowGeneratedSummaries": {
          "type": "boolean"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxTokens",
        "reservedTokens",
        "tokenizerFallback"
      ],
      "properties": {
        "maxTokens": {
          "type": "integer",
          "minimum": 1
        },
        "reservedTokens": {
          "type": "integer",
          "minimum": 0
        },
        "preferredTokenizer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "tokenizerFallback": {
          "enum": [
            "conservative_estimator",
            "reject_if_unknown"
          ]
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ttlSeconds",
        "revalidateAuthorizationBeforeDelivery"
      ],
      "properties": {
        "ttlSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "revalidateAuthorizationBeforeDelivery": {
          "const": true
        }
      }
    },
    "redactionPolicyRef": {
      "type": "string",
      "minLength": 1
    }
  }
}
