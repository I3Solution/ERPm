{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ekp:extraction-manifest:1.0",
  "title": "Enterprise Knowledge Platform ExtractionManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "manifestId", "runId", "scope", "sourceId", "sourceRevisionId",
    "inputCaptureManifest", "extractor", "observationArtifacts",
    "observationCount", "unsupportedCount", "coverage", "completedAtUtc"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "ekp.extraction-manifest" },
        "version": { "const": "1.0" }
      }
    },
    "manifestId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "workspaceId"],
      "properties": {
        "tenantId": { "type": "string", "minLength": 1 },
        "workspaceId": { "type": "string", "minLength": 1 },
        "projectId": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "sourceId": { "type": "string", "minLength": 1 },
    "sourceRevisionId": { "type": "string", "minLength": 1 },
    "inputCaptureManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestId", "contentHash"],
      "properties": {
        "manifestId": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "minLength": 1 }
      }
    },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "outputContract"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "outputContract": { "type": "string", "minLength": 1 }
      }
    },
    "observationArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "storageRef", "mediaType", "contentHash", "byteLength", "observationCount"],
        "properties": {
          "artifactId": { "type": "string", "minLength": 1 },
          "storageRef": { "type": "string", "minLength": 1 },
          "mediaType": { "type": "string", "minLength": 1 },
          "contentHash": { "type": "string", "minLength": 1 },
          "byteLength": { "type": "integer", "minimum": 0 },
          "observationCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "observationCount": { "type": "integer", "minimum": 0 },
    "unsupportedCount": { "type": "integer", "minimum": 0 },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "numerator", "denominator", "ratio"],
        "properties": {
          "metric": { "type": "string", "minLength": 1 },
          "numerator": { "type": "integer", "minimum": 0 },
          "denominator": { "type": "integer", "minimum": 1 },
          "ratio": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "omissionReportRef": { "type": "string", "minLength": 1 },
    "completedAtUtc": { "type": "string", "format": "date-time" }
  }
}
