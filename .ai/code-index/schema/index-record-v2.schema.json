{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/I3Solution/ERPm/blob/master/.ai/code-index/schema/index-record-v2.schema.json",
  "title": "ERPm Code Index Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "indexerVersion",
    "repositoryId",
    "commitSha",
    "path",
    "kind",
    "symbolKind",
    "symbolId",
    "name",
    "qualifiedName",
    "language",
    "startLine",
    "endLine",
    "relation",
    "sourceSymbolId",
    "sourceSymbolKind",
    "targetSymbolId",
    "evidence",
    "generatedAtUtc"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "indexerVersion": { "type": "string", "minLength": 1 },
    "repositoryId": { "type": "string", "minLength": 1 },
    "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
    "kind": { "type": "string", "enum": ["definition", "reference", "project", "dependency"] },
    "symbolKind": {
      "type": "string",
      "enum": ["namespace", "type", "method", "field", "property", "event", "parameter", "local", "typeParameter", "other"]
    },
    "symbolId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "qualifiedName": { "type": ["string", "null"] },
    "language": { "type": "string", "minLength": 1 },
    "startLine": { "type": "integer", "minimum": 1 },
    "endLine": { "type": "integer", "minimum": 1 },
    "relation": { "type": ["string", "null"] },
    "sourceSymbolId": { "type": ["string", "null"] },
    "sourceSymbolKind": {
      "type": ["string", "null"],
      "enum": ["namespace", "type", "method", "field", "property", "event", "parameter", "local", "typeParameter", "other", null]
    },
    "targetSymbolId": { "type": ["string", "null"] },
    "evidence": { "type": "string", "enum": ["verified", "partial", "unknown"] },
    "generatedAtUtc": { "type": "string", "format": "date-time" }
  }
}
