{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ekp:processing-manifest:1.0",
  "title": "Enterprise Knowledge Platform ProcessingManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "manifestId", "runId", "scope", "sourceId", "sourceRevisionId",
    "inputManifest", "processor", "outputArtifacts", "lineagePreserved",
    "inputItemCount", "outputItemCount", "rejectedItemCount", "completedAtUtc"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "ekp.processing-manifest" },
        "version": { "const": "1.0" }
      }
    },
    "manifestId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "workspaceId"],
      "properties": {
        "tenantId": { "type": "string", "minLength": 1 },
        "workspaceId": { "type": "string", "minLength": 1 },
        "projectId": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "sourceId": { "type": "string", "minLength": 1 },
    "sourceRevisionId": { "type": "string", "minLength": 1 },
    "inputManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestId", "contentHash", "artifactIds"],
      "properties": {
        "manifestId": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "minLength": 1 },
        "artifactIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "processor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "requiredByProfile"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "requiredByProfile": { "type": "boolean" },
        "ordinal": { "type": "integer", "minimum": 0 }
      }
    },
    "outputArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "storageRef", "mediaType", "contentHash", "byteLength", "itemCount"],
        "properties": {
          "artifactId": { "type": "string", "minLength": 1 },
          "storageRef": { "type": "string", "minLength": 1 },
          "mediaType": { "type": "string", "minLength": 1 },
          "contentHash": { "type": "string", "minLength": 1 },
          "byteLength": { "type": "integer", "minimum": 0 },
          "itemCount": { "type": "integer", "minimum": 0 },
          "parentArtifactIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "lineagePreserved": { "const": true },
    "inputItemCount": { "type": "integer", "minimum": 0 },
    "outputItemCount": { "type": "integer", "minimum": 0 },
    "rejectedItemCount": { "type": "integer", "minimum": 0 },
    "completedAtUtc": { "type": "string", "format": "date-time" }
  }
}
