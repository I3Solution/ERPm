{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ekp:payload:code.api_observation:1.0",
  "title": "Enterprise Knowledge Platform code.api_observation payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "data"],
  "properties": {
    "type": { "const": "code.api_observation" },
    "version": { "const": "1.0" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "httpMethod",
        "urlKind",
        "expression",
        "literalPath",
        "containingSymbolId",
        "sourceObservationId",
        "language"
      ],
      "properties": {
        "httpMethod": {
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD", "UNKNOWN"]
        },
        "urlKind": { "enum": ["literal", "interpolated", "dynamic"] },
        "expression": { "type": "string", "minLength": 1 },
        "literalPath": { "type": ["string", "null"] },
        "containingSymbolId": { "type": ["string", "null"] },
        "sourceObservationId": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "urlKind": { "const": "literal" } },
            "required": ["urlKind"]
          },
          "then": {
            "properties": { "literalPath": { "type": "string", "minLength": 1 } }
          },
          "else": {
            "properties": { "literalPath": { "type": "null" } }
          }
        }
      ]
    }
  }
}
