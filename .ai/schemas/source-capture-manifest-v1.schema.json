{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ekp:source-capture-manifest:1.0",
  "title": "Enterprise Knowledge Platform SourceCaptureManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "manifestId", "runId", "scope", "sourceId",
    "sourceRevision", "connector", "snapshotConsistency",
    "artifacts", "capturedAtUtc"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "ekp.source-capture-manifest" },
        "version": { "const": "1.0" }
      }
    },
    "manifestId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "workspaceId"],
      "properties": {
        "tenantId": { "type": "string", "minLength": 1 },
        "workspaceId": { "type": "string", "minLength": 1 },
        "projectId": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "sourceId": { "type": "string", "minLength": 1 },
    "sourceRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRevisionId", "revisionKind", "revisionKey", "contentHash"],
      "properties": {
        "sourceRevisionId": { "type": "string", "minLength": 1 },
        "revisionKind": { "type": "string", "minLength": 1 },
        "revisionKey": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "minLength": 1 }
      }
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "snapshotConsistency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "strategy"],
      "properties": {
        "state": { "const": "consistent" },
        "strategy": {
          "enum": [
            "immutable_upstream_version",
            "content_hash_snapshot",
            "git_commit",
            "database_export"
          ]
        },
        "verifiedAtUtc": { "type": "string", "format": "date-time" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "role", "storageRef", "mediaType", "contentHash", "byteLength"],
        "properties": {
          "artifactId": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "storageRef": { "type": "string", "minLength": 1 },
          "mediaType": { "type": "string", "minLength": 1 },
          "contentHash": { "type": "string", "minLength": 1 },
          "byteLength": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "sourceMetadataRef": { "type": "string", "minLength": 1 },
    "capturedAtUtc": { "type": "string", "format": "date-time" }
  }
}
