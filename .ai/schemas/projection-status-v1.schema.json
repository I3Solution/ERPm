{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ekp:projection-status:1.0",
  "title": "Enterprise Knowledge Platform ProjectionStatus v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "statusId",
    "scope",
    "sourceId",
    "sourceRevisionId",
    "sourcePublication",
    "projectionKind",
    "desiredProfile",
    "state",
    "eligibleForRetrieval",
    "updatedAtUtc"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "ekp.projection-status"
        },
        "version": {
          "const": "1.0"
        }
      }
    },
    "statusId": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "workspaceId"
      ],
      "properties": {
        "tenantId": {
          "type": "string",
          "minLength": 1
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "projectId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "sourceRevisionId": {
      "type": "string",
      "minLength": 1
    },
    "sourcePublication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestId",
        "contentHash"
      ],
      "properties": {
        "manifestId": {
          "type": "string",
          "minLength": 1
        },
        "contentHash": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "projectionKind": {
      "enum": [
        "full_text",
        "vector"
      ]
    },
    "desiredProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "version",
        "definitionFingerprint"
      ],
      "properties": {
        "profileId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "definitionFingerprint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "state": {
      "enum": [
        "pending",
        "building",
        "ready",
        "failed",
        "stale"
      ]
    },
    "eligibleForRetrieval": {
      "type": "boolean"
    },
    "projectionManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestId",
        "contentHash",
        "sourceRevisionId",
        "sourcePublicationManifestId",
        "profileId",
        "profileVersion",
        "definitionFingerprint",
        "projectionVersion",
        "sourcePublicationContentHash"
      ],
      "properties": {
        "manifestId": {
          "type": "string",
          "minLength": 1
        },
        "contentHash": {
          "type": "string",
          "minLength": 1
        },
        "sourceRevisionId": {
          "type": "string",
          "minLength": 1
        },
        "sourcePublicationManifestId": {
          "type": "string",
          "minLength": 1
        },
        "profileId": {
          "type": "string",
          "minLength": 1
        },
        "profileVersion": {
          "type": "string",
          "minLength": 1
        },
        "definitionFingerprint": {
          "type": "string",
          "minLength": 1
        },
        "projectionVersion": {
          "type": "string",
          "minLength": 1
        },
        "sourcePublicationContentHash": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "latestProjectionRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectionRunId",
        "state"
      ],
      "properties": {
        "projectionRunId": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "queued",
            "building",
            "succeeded",
            "failed",
            "canceled",
            "superseded"
          ]
        }
      }
    },
    "unavailableReason": {
      "enum": [
        "not_built",
        "build_in_progress",
        "build_failed",
        "source_revision_changed",
        "profile_version_changed",
        "definition_changed",
        "publication_not_available",
        "projection_revoked"
      ]
    },
    "updatedAtUtc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "ready"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "projectionManifest"
        ],
        "properties": {
          "eligibleForRetrieval": {
            "const": true
          }
        },
        "not": {
          "required": [
            "unavailableReason"
          ]
        }
      },
      "else": {
        "required": [
          "unavailableReason"
        ],
        "properties": {
          "eligibleForRetrieval": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "pending"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "unavailableReason": {
            "const": "not_built"
          }
        },
        "not": {
          "required": [
            "projectionManifest"
          ]
        },
        "required": [
          "unavailableReason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "building"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "latestProjectionRun"
        ],
        "properties": {
          "unavailableReason": {
            "const": "build_in_progress"
          },
          "latestProjectionRun": {
            "properties": {
              "state": {
                "enum": [
                  "queued",
                  "building"
                ]
              }
            },
            "required": [
              "state"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "latestProjectionRun",
          "unavailableReason"
        ],
        "properties": {
          "unavailableReason": {
            "const": "build_failed"
          },
          "latestProjectionRun": {
            "properties": {
              "state": {
                "const": "failed"
              }
            },
            "required": [
              "state"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "stale"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "projectionManifest",
          "unavailableReason"
        ],
        "properties": {
          "unavailableReason": {
            "enum": [
              "source_revision_changed",
              "profile_version_changed",
              "definition_changed",
              "projection_revoked"
            ]
          }
        }
      }
    }
  ]
}
