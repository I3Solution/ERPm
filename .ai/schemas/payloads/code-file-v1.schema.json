{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ekp:payload:code.file:1.0",
  "title": "Enterprise Knowledge Platform code.file payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "data"],
  "properties": {
    "type": { "const": "code.file" },
    "version": { "const": "1.0" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "language"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
        },
        "language": { "type": "string", "minLength": 1 },
        "sourceSymbolId": { "type": ["string", "null"] }
      }
    }
  }
}
